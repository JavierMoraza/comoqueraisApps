<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/background_fab">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginRight="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elige una barra"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H1 (20%)"
                        android:textColor="#E0E0E0" />

                    <!-- Usamos marginTop para separarlo del de arriba -->
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H2 (50%)"
                        android:textColor="#E0E0E0"
                        android:layout_marginTop="12dp" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H3 (80%)"
                        android:textColor="#E0E0E0"
                        android:layout_marginTop="12dp" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="V1 (20%)"
                        android:textColor="#E0E0E0"
                        android:layout_marginTop="12dp" />
                </RadioGroup>
            </LinearLayout>

            <!-- COLUMNA DERECHA: COLORES -->
            <!-- Le damos un margin left para que respire por la izquierda -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elige un color"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blanco"
                        android:textColor="#E0E0E0"
                        android:buttonTint="#FFFFFF" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rojo"
                        android:textColor="#E0E0E0"
                        android:buttonTint="#FF0000"
                        android:layout_marginTop="12dp" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Naranja"
                        android:textColor="#E0E0E0"
                        android:buttonTint="#FF9800"
                        android:layout_marginTop="12dp" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amarillo"
                        android:textColor="#E0E0E0"
                        android:buttonTint="#FFEB3B"
                        android:layout_marginTop="12dp" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- BOTÓN INFERIOR -->
        <!-- Lo separamos de los botones de arriba con un marginTop grande -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="Aplicar color"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/bgapp_background_card"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>